<mujoco model="lift_cube_scene">
    <include file="so101_new_calib.xml" />

    <option timestep="0.002" gravity="0 0 -9.81" noslip_iterations="3" impratio="10" cone="elliptic"/>

    <default>
        <geom solref="0.001 1" solimp="0.99 0.99 0.001"/>
    </default>

    <visual>
        <!-- 부드러운 실내 조명 (과도한 그림자 및 난반사 억제) -->
        <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0.05 0.05 0.05" />
        <rgba haze="0.95 0.95 0.95 1" />
        <global azimuth="90" elevation="-20" offwidth="1280" offheight="768"/>
        <map znear="0.005" />
    </visual>

    <asset>
        <!-- 부드러운 화이트 톤 스카이박스 -->
        <texture type="skybox" builtin="gradient" rgb1="0.96 0.96 0.98" rgb2="0.88 0.90 0.92" width="512" height="512" />
        
        <!-- 매트한 흰색 책상 바닥 재질 (반사율 0으로 설정하여 노이즈 제거) -->
        <material name="mat_white_desk" rgba="0.94 0.94 0.94 1.0" specular="0.02" roughness="0.9" reflectance="0.0" />
        
        <!-- 타깃 레드 큐브 재질 -->
        <material name="cube_material" rgba="0.9 0.1 0.1 1.0" specular="0.2" roughness="0.4" />

        <!-- DICT_6X6_250, ID 23. PNG and metadata are generated by
             so101_real_leader_mujoco_il.aruco_reference.generate_marker. -->
        <texture name="aruco_reference_texture" type="2d" file="aruco_6x6_250_id23.png"/>
        <material name="aruco_reference_material"
                  texture="aruco_reference_texture"
                  texrepeat="1 1" texuniform="false"
                  rgba="1 1 1 1" specular="0" shininess="0" reflectance="0"/>
    </asset>

    <worldbody>
        <!-- 상단 조명 (그림자 드리움 적용) -->
        <light pos="0 0 3.5" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.05 0.05 0.05" directional="true" castshadow="true" />
        
        <!-- 흰색 책상 바닥 평면 -->
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="mat_white_desk" friction="1.0 0.005 0.0001" />

        <!-- 12 cm visual reference in the current single-arm camera lane.
             For a dual-arm XML, set Y to the midpoint of the two arm bases.
             It is raised 2 mm to avoid z-fighting and has no collision. -->
        <body name="aruco_reference_frame" pos="0.25 -0.15 0.002">
            <geom name="aruco_reference_marker" type="plane"
                  size="0.06 0.06 0.001"
                  material="aruco_reference_material"
                  contype="0" conaffinity="0"/>
            <site name="aruco_reference_origin" type="sphere"
                  pos="0 0 0.003" size="0.003" rgba="1 0 0 0"/>
        </body>

        <!-- Debug camera -->
        <camera name="origin_cam" pos="0.0 0.4 0.4" xyaxes="-1 1 0 -0.5 -0.5 1" fovy="60"/>

        <!-- Cube to pick up: 3x3x3cm -->
        <body name="cube" pos="0.40 0.10 0">
            <freejoint name="cube_joint"/>
            <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.03" material="cube_material" friction="0.5 0.05 0.001"/>
        </body>
    </worldbody>

    <sensor>
        <!-- Cube position -->
        <framepos name="cube_pos" objtype="body" objname="cube" />
        <!-- Gripper TCP position (10cm in front of gripper) -->
        <framepos name="gripper_pos" objtype="site" objname="gripperframe" />
        <!-- Grasp point position (between fingers, for reach reward) -->
        <framepos name="grasp_pos" objtype="site" objname="graspframe" />
        <!-- Ground-truth reference pose for simulation/debugging only. ACT and
             miniVLA receive the rendered marker, not these privileged sensors. -->
        <framepos name="aruco_reference_pos" objtype="body" objname="aruco_reference_frame" />
        <framequat name="aruco_reference_quat" objtype="body" objname="aruco_reference_frame" />
    </sensor>
</mujoco>
